{
  "name": "signal-sticker-studio",
  "productName": "Signal Sticker Optimiser",
  "version": "0.1.0",
  "description": "Offline converter for turning images and animations into Signal-compliant sticker packs",
  "license": "MIT",
  "author": "",
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write .",
    "dist": "electron-vite build && electron-builder"
  },
  "dependencies": {
    "@imgly/background-removal": "1.7.0",
    "ffmpeg-static": "5.3.0",
    "onnxruntime-web": "1.21.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.12.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/browser-playwright": "5.1.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "10.14.0",
    "happy-dom": "^21.0.4",
    "playwright": "^1.65.0",
    "prettier": "^3.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "electron@45.2.3": true,
    "ffmpeg-static@5.3.0": true
  }
}
